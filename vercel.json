{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://aqario-luxe-apii.vercel.app/api/:path*"
    },
    {
      "source": "/((?!api|assets|robots.txt|sitemap.xml|.*\\.[a-zA-Z0-9]+$).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)\\.(js|css|woff2|woff|ttf|png|jpg|jpeg|svg|ico|webp|avif)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
